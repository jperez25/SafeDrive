{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.safedrive.local/events/driving.event.v1.schema.json",
  "title": "driving.event v1",
  "allOf": [ { "$ref": "envelope.v1.schema.json" } ],
  "properties": {
    "type": { "const": "driving.event" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["tripId", "driverId", "kind", "severity", "ts", "lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "tripId": { "type": "string", "minLength": 1 },
        "driverId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["hard_brake", "harsh_accel", "speeding", "distraction", "crash"] },
        "severity": { "enum": ["low", "medium", "high"] },
        "ts": { "type": "string", "format": "date-time" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    }
  },
  "unevaluatedProperties": false
}
